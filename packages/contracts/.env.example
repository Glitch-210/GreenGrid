# hardhat.config.ts reads these from THIS directory via dotenv/config —
# apps/api/.env is a separate file and is not picked up here.

BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Throwaway testnet key only — never one holding real funds (IMPLEMENTATION_PLAN §13).
# The deployer becomes the contract's operator, so use the same key in apps/api/.env.
BLOCKCHAIN_PRIVATE_KEY=0x<throwaway testnet key>
# Set after `npm run deploy:amoy`; only `npm run check:amoy` reads it.
SMART_CONTRACT_ADDRESS=0x...
