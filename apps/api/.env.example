PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET=<32+ random bytes>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,https://<vercel-app>.vercel.app

PLATFORM_FEE_RATE=0.05
CREDIT_VALIDITY_HOURS=72
RESERVATION_TTL_MINUTES=5
SIM_SPEED_MULTIPLIER=60
SIM_TICK_MS=30000

CHAIN_MODE=simulated
BLOCKCHAIN_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
BLOCKCHAIN_PRIVATE_KEY=<operator key — testnet only, never reuse>
SMART_CONTRACT_ADDRESS=0x...

UTILITY_ADAPTER=mock
DISCOM_MODE=ok

# Point integration tests at an isolated database (docker-compose.yml provides one).
TEST_DATABASE_URL="postgresql://wattshare:wattshare@localhost:5432/wattshare_test"
